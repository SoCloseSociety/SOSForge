<?xml version="1.0" encoding="utf-8"?>
<!--
  The RELEASE network config: cleartext is OFF, for every host. SOSForge lives at
  https://sosforge.soclose.co and a release talks to nothing else (owner rule, 2026-10-27).
  Debug builds replace this file (src/debug/res/xml) to reach a local server on the emulator.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
