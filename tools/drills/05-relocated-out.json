              "event": "Amber wind warning",
              "headline": "[DRILL] Amber wind warning",
              "severity": "Severe",
              "certainty": "Likely",
              "urgency": "Expected",
              "responseType": [
                "Prepare"
              ],
              "onset": "@iso-1h",
              "expires": "@iso+10h",
              "web": "https://www.metoffice.gov.uk/weather/warnings-and-advice/uk-warnings",
              "description": "[DRILL] Exercise, not a real warning.",
