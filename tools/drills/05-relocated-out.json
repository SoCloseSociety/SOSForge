          "alert": null,
          "status": "automatic",
          "tsunami": 0,
          "sig": 500,
          "magType": "mww",
          "type": "earthquake",
          "title": "M 5.9 - [DRILL] 30 km E of Tsuchiura, Japan"
        },
        "geometry": {
          "type": "Point",
          "coordinates": [
            140.5,
            36.05,
            40.0
          ]
        }
      }
    },
