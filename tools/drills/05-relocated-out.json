  "steps": [
    {
      "at": 0,
      "note": "M5.9 50 km NE of Tokyo",
      "source": "usgs",
      "payload": {
        "type": "Feature",
        "id": "drill{run}q2",
        "properties": {
          "mag": 5.9,
          "place": "[DRILL] 30 km E of Tsuchiura, Japan",
          "time": "@ms-40s",
          "updated": "@ms-0s",
          "url": "https://earthquake.usgs.gov/earthquakes/eventpage/drill{run}q2",
          "felt": null,
