# SOSForge -- configuration. Copier en .env et ajuster.
# Aucune cle API n'est necessaire: les six sources sont publiques et ouvertes.

# --- serveur ---
SOS_HOST=0.0.0.0
SOS_PORT=8300
SOS_LOG_LEVEL=INFO
SOS_CORS_ORIGINS=http://localhost:5273,http://127.0.0.1:5273

# --- stockage (ring buffer en memoire + journal JSONL) ---
SOS_DATA_DIR=./data
SOS_RING_SIZE=5000
SOS_SNAPSHOT_SIZE=300
SOS_PERSIST_JSONL=true

# --- sources (toutes actives par defaut) ---
SOS_ENABLE_EMSC_WS=true
SOS_ENABLE_USGS=true
SOS_ENABLE_TSUNAMI=true
SOS_ENABLE_GDACS=true
SOS_ENABLE_NWS=true
SOS_ENABLE_VOLCANO=true
# agences regionales: ce que l'EMSC n'a pas (shindo japonais, potentiel tsunami
# indonesien, seuils de detection locaux)
SOS_ENABLE_JMA=true
SOS_ENABLE_BMKG=true
SOS_ENABLE_GEONET=true
SOS_ENABLE_INGV=true
SOS_ENABLE_AFAD=true
# aleas non sismiques
SOS_ENABLE_NHC=true
SOS_ENABLE_ASH=true

# --- cadences de polling (secondes) ---
SOS_USGS_POLL_SECONDS=5
SOS_TSUNAMI_POLL_SECONDS=30
SOS_NWS_POLL_SECONDS=20
SOS_GDACS_POLL_SECONDS=120
SOS_VOLCANO_POLL_SECONDS=300
SOS_JMA_POLL_SECONDS=45
SOS_BMKG_POLL_SECONDS=60
SOS_GEONET_POLL_SECONDS=60
SOS_INGV_POLL_SECONDS=60
SOS_AFAD_POLL_SECONDS=60
SOS_NHC_POLL_SECONDS=300
SOS_ASH_POLL_SECONDS=180

# GDACS: age max (en jours) d'une alerte verte encore affichee.
# Orange et rouge ne sont jamais filtrees.
SOS_GDACS_MAX_AGE_DAYS=1

# --- vues en direct autour d'un evenement (optionnel) ---
# Sans cle, la fiche propose deja des liens qui marchent partout (Windy,
# YouTube live, NASA Worldview, Google Maps). Avec une cle Windy (gratuite),
# elle liste les webcams publiques a proximite, avec vignettes.
SOS_WINDY_API_KEY=
SOS_NEARBY_RADIUS_KM=100

# --- diffusion ---
SOS_HEARTBEAT_SECONDS=1
# magnitude plancher a l'ingestion (0 = tout garder, y compris les micro-seismes)
SOS_MIN_MAGNITUDE=0
# horizon d'ingestion: la liste JMA remonte a plus de 9 mois, ce n'est pas de
# l'actualite. Une alerte grave ET EN COURS (cyclone rouge) n'est jamais coupee.
SOS_MAX_EVENT_AGE_DAYS=3
# en deca de cet age, un evenement est annonce "en direct" (halo, son)
SOS_BREAKING_SECONDS=900

# --- dedup inter-sources (EMSC vs USGS sur le meme seisme) ---
SOS_DEDUPE_WINDOW_SECONDS=90
SOS_DEDUPE_RADIUS_KM=250
SOS_DEDUPE_MAG_DELTA=1.2
