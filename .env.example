# SOSForge -- configuration. Copy to .env and adjust.
# No API key is required: all nineteen sources are public and open.

# --- server ---
SOS_HOST=0.0.0.0
SOS_PORT=8300
SOS_LOG_LEVEL=INFO
SOS_CORS_ORIGINS=http://localhost:5273,http://127.0.0.1:5273

# --- storage (in-memory ring buffer + JSONL journal) ---
SOS_DATA_DIR=./data
SOS_RING_SIZE=5000
SOS_SNAPSHOT_SIZE=300
SOS_PERSIST_JSONL=true
# journal retention (about 5 MB per day)
SOS_JOURNAL_KEEP_DAYS=7

# --- sources (all enabled by default) ---
SOS_ENABLE_EMSC_WS=true
SOS_ENABLE_USGS=true
SOS_ENABLE_TSUNAMI=true
SOS_ENABLE_GDACS=true
SOS_ENABLE_NWS=true
SOS_ENABLE_VOLCANO=true
# regional agencies: what EMSC does not have (Japanese shindo, Indonesian
# tsunami potential, low local detection thresholds)
SOS_ENABLE_JMA=true
SOS_ENABLE_BMKG=true
SOS_ENABLE_GEONET=true
SOS_ENABLE_INGV=true
SOS_ENABLE_AFAD=true
# non-seismic hazards
SOS_ENABLE_NHC=true
SOS_ENABLE_ASH=true

# --- polling rates (seconds) ---
SOS_USGS_POLL_SECONDS=5
SOS_TSUNAMI_POLL_SECONDS=30
SOS_NWS_POLL_SECONDS=20
SOS_GDACS_POLL_SECONDS=120
SOS_VOLCANO_POLL_SECONDS=300
SOS_JMA_POLL_SECONDS=45
SOS_BMKG_POLL_SECONDS=60
SOS_GEONET_POLL_SECONDS=60
SOS_INGV_POLL_SECONDS=60
SOS_AFAD_POLL_SECONDS=60
SOS_NHC_POLL_SECONDS=300
SOS_ASH_POLL_SECONDS=180

# GDACS: max age (in days) of a green alert still displayed.
# Orange and red are never filtered out.
SOS_GDACS_MAX_AGE_DAYS=1

# --- live views around an event (optional) ---
# Without a key, the card already offers links that work everywhere (Windy,
# YouTube live, NASA Worldview, Google Maps). With a free Windy key, it lists
# nearby public webcams with thumbnails.
SOS_WINDY_API_KEY=
SOS_NEARBY_RADIUS_KM=100

# --- broadcast ---
SOS_HEARTBEAT_SECONDS=1
# magnitude floor at ingestion (0 = keep everything, micro-quakes included)
SOS_MIN_MAGNITUDE=0
# ingestion horizon: the JMA list goes back more than 9 months, which is not
# current news. A severe AND ONGOING alert (red cyclone) is never cut.
SOS_MAX_EVENT_AGE_DAYS=3
# below this age, an event is announced as "live" (halo, sound)
SOS_BREAKING_SECONDS=900

# --- cross-source dedup (EMSC vs USGS on the same earthquake) ---
SOS_DEDUPE_WINDOW_SECONDS=90
SOS_DEDUPE_RADIUS_KM=250
SOS_DEDUPE_MAG_DELTA=1.2
